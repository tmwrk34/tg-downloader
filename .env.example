# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of whitelisted Telegram chat IDs:
# - Positive IDs (>0): Admin / developer personal user IDs
# - Negative IDs (<0): Group or supergroup chat IDs (usually start with -100)
ALLOWED_CHAT_IDS=7177930122,987654321,-1002366722481

# Optional: Local Telegram Bot API Server (enables 2GB file upload limit)
# Obtain your API ID & Hash from https://my.telegram.org
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# Optional: Worker Concurrency Limits (protects Raspberry Pi from OOM / CPU starvation)
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_TRANSCODES=1
